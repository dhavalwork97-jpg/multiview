# --- Database ---
DATABASE_URL="postgresql://fgc:fgc_dev_password@localhost:5432/fgc_stream?schema=public"

# --- Redis (required in production for Socket.IO/app events) ---
# Local development default. Set the real Upstash redis:// URL in Vercel/Render.
REDIS_URL="redis://localhost:6379"

# --- YouTube quota safety ---
# Application-side ceiling. 3000 units leaves a large margin below the usual
# Google project quota and prevents runaway broadcast creation.
YOUTUBE_DAILY_QUOTA_BUDGET="3000"

# --- Upstash REST credentials (rate limiting only — see src/lib/rate-limit.ts) ---
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxx"

# --- Clerk auth ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
# Silences "Missing CLERK_ENCRYPTION_KEY" in production logs (see
# DEPLOYMENT_GUIDE.md Stage 1.2 for why). Not required for local dev.
# Generate with: openssl rand -hex 32
CLERK_ENCRYPTION_KEY="xxx"
CLERK_WEBHOOK_SIGNING_SECRET="whsec_xxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL="/dashboard"

# --- Stripe (prepared for launch, billing intentionally disabled) ---
# Configure these only when paid plans launch.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PREMIUM_PRICE_ID=
