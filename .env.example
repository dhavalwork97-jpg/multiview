# --- Database ---
DATABASE_URL="postgresql://fgc:fgc_dev_password@localhost:5432/fgc_stream?schema=public"

# --- Redis (required in production for Socket.IO/app events) ---
REDIS_URL="redis://localhost:6379"

# --- YouTube quota safety ---
YOUTUBE_DAILY_QUOTA_BUDGET="3000"

# --- Upstash REST credentials (rate limiting only) ---
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxx"

# --- Clerk auth ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
CLERK_ENCRYPTION_KEY="xxx"
CLERK_WEBHOOK_SIGNING_SECRET="whsec_xxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# --- Supabase Storage (free media storage / S3-compatible egress) ---
# Enable S3 protocol in Supabase Storage settings and generate server-side keys.
SUPABASE_S3_ENDPOINT="https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3"
SUPABASE_S3_REGION="YOUR_PROJECT_REGION"
SUPABASE_S3_ACCESS_KEY_ID="YOUR_S3_ACCESS_KEY_ID"
SUPABASE_S3_SECRET_ACCESS_KEY="YOUR_S3_SECRET_ACCESS_KEY"
# Public project URL or Storage URL. Example: https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_STORAGE_URL="https://YOUR_PROJECT_REF.supabase.co"
# One public bucket shared by VOD/HLS/clip prefixes.
NEXT_PUBLIC_SUPABASE_BUCKET="media"

# --- Stripe ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_STARTER_PRICE_ID=
# STRIPE_PRO_PRICE_ID=
# STRIPE_EVENT_PRICE_ID=

# --- LiveKit ---
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_WS_URL=""
LIVEKIT_HTTP_URL=""

# --- YouTube ---
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REFRESH_TOKEN=""
