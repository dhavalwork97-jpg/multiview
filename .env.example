# --- Database ---
DATABASE_URL="postgresql://fgc:fgc_dev_password@localhost:5432/fgc_stream?schema=public"

# --- Redis (required in production for Socket.IO/app events) ---
REDIS_URL="redis://localhost:6379"
NEXT_PUBLIC_SOCKET_URL="https://fgc-stream-socket.onrender.com"
FGC_OBS_BRIDGE_TOKEN="replace-with-a-long-random-token"
FGC_SOCKET_INTERNAL_URL="https://fgc-stream-socket.onrender.com"
FGC_SOCKET_INTERNAL_TOKEN="replace-with-the-same-random-token"
FGC_STREAM_DECK_TOKEN="replace-with-a-long-random-token"

# --- YouTube / broadcast automation ---
# Create OAuth 2.0 Web application credentials in Google Cloud.
YOUTUBE_CLIENT_ID="your-google-oauth-client-id"
YOUTUBE_CLIENT_SECRET="your-google-oauth-client-secret"
# Encrypts tournament-scoped YouTube refresh tokens at rest.
BROADCAST_ENCRYPTION_KEY="replace-with-a-long-random-secret"
# Optional separate HMAC secret for OAuth state signing. Falls back to BROADCAST_ENCRYPTION_KEY.
BROADCAST_OAUTH_STATE_SECRET="replace-with-a-long-random-secret"
NEXT_PUBLIC_APP_URL="https://multiview-fjtd.vercel.app"
YOUTUBE_DAILY_QUOTA_BUDGET="3000"

# --- Upstash REST credentials (rate limiting only) ---
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxx"

# --- Clerk auth ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
CLERK_ENCRYPTION_KEY="xxx"
CLERK_WEBHOOK_SIGNING_SECRET="whsec_xxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# --- Stripe (prepared for launch, billing intentionally disabled) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
