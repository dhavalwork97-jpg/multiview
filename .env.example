# --- Database ---
DATABASE_URL="postgresql://fgc:fgc_dev_password@localhost:5432/fgc_stream?schema=public"

# --- Redis (pub/sub for Socket.IO adapter, station heartbeat cache) ---
REDIS_URL="redis://localhost:6379"

# --- Clerk auth ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
CLERK_WEBHOOK_SIGNING_SECRET="whsec_xxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# --- Stripe (wired in a later phase; keys reserved now so schema/env stay stable) ---
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
STRIPE_PREMIUM_PRICE_ID="price_xxx"

# --- LiveKit (self-hosted media server — see infra/livekit) ---
LIVEKIT_API_KEY="xxx"
LIVEKIT_API_SECRET="xxx"
LIVEKIT_WS_URL="wss://media.fgcstream.com"
LIVEKIT_HTTP_URL="https://media.fgcstream.com"
LIVEKIT_WEBHOOK_SIGNING_SECRET="xxx"

# --- AWS (used starting Phase 3 streaming/storage work) ---
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="xxx"
AWS_SECRET_ACCESS_KEY="xxx"
S3_BUCKET_VODS="fgc-stream-vods"
S3_BUCKET_CLIPS="fgc-stream-clips"
CLOUDFRONT_DOMAIN="xxx.cloudfront.net"
NEXT_PUBLIC_CLOUDFRONT_DOMAIN="xxx.cloudfront.net"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SOCKET_SERVER_PORT="4000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
