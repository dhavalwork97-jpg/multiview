# --- Database ---
DATABASE_URL="postgresql://fgc:fgc_dev_password@localhost:5432/fgc_stream?schema=public"

# --- Redis (required in production for Socket.IO/app events) ---
REDIS_URL="redis://localhost:6379"
NEXT_PUBLIC_SOCKET_URL="https://fgc-stream-socket.onrender.com"
FGC_OBS_BRIDGE_TOKEN="replace-with-a-long-random-token"
FGC_SOCKET_INTERNAL_URL="https://fgc-stream-socket.onrender.com"
FGC_SOCKET_INTERNAL_TOKEN="replace-with-the-same-random-token"
FGC_STREAM_DECK_TOKEN="replace-with-a-long-random-token"

# --- Broadcast automation: platform configuration only ---
# Organizers never enter Vercel/Render environment variables.
# Google OAuth credentials belong to the FGC Stream platform and are used for the product OAuth app.
YOUTUBE_CLIENT_ID="your-google-oauth-client-id"
YOUTUBE_CLIENT_SECRET="your-google-oauth-client-secret"
# Vercel OIDC + Google Cloud KMS encrypts organizer/tournament secrets. These are identifiers, not secret keys.
# Configure Vercel Secure Backend Access with OIDC and a Google Cloud Workload Identity Federation provider.
GCP_PROJECT_NUMBER="123456789012"
GCP_SERVICE_ACCOUNT_EMAIL="vercel-broadcast-kms@your-project.iam.gserviceaccount.com"
GCP_WORKLOAD_IDENTITY_POOL_ID="vercel"
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID="vercel"
GCP_KMS_KEY_NAME="projects/your-project/locations/global/keyRings/fgc-stream/cryptoKeys/broadcast-secrets"
# Must be the public FGC Stream URL; the OAuth callback is /api/broadcast/youtube/callback.
NEXT_PUBLIC_APP_URL="https://multiview-fjtd.vercel.app"
YOUTUBE_DAILY_QUOTA_BUDGET="3000"

# --- Upstash REST credentials (rate limiting only) ---
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxx"

# --- Clerk auth ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
CLERK_ENCRYPTION_KEY="xxx"
CLERK_WEBHOOK_SIGNING_SECRET="whsec_xxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# --- Stripe (prepared for launch, billing intentionally disabled) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PREMIUM_PRICE_ID=
