# --- Database ---
DATABASE_URL="postgresql://fgc:fgc_dev_password@localhost:5432/fgc_stream?schema=public"

# --- Redis (pub/sub for Socket.IO adapter, station heartbeat cache) ---
REDIS_URL="redis://localhost:6379"

# --- Upstash REST credentials (rate limiting only — see src/lib/rate-limit.ts) ---
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxx"

# --- Clerk auth ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
# Silences "Missing CLERK_ENCRYPTION_KEY" in production logs (see
# DEPLOYMENT_GUIDE.md Stage 1.2 for why). Not required for local dev.
# Generate with: openssl rand -hex 32
CLERK_ENCRYPTION_KEY="xxx"
CLERK_WEBHOOK_SIGNING_SECRET="whsec_xxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# --- Stripe (wired in a later phase; keys reserved now so schema/env stay stable) ---
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
STRIPE_PREMIUM_PRICE_ID="price_xxx"

# --- LiveKit (self-hosted media server — see infra/livekit) ---
LIVEKIT_API_KEY="xxx"
LIVEKIT_API_SECRET="xxx"
LIVEKIT_WS_URL="wss://media.fgcstream.com"
LIVEKIT_HTTP_URL="https://media.fgcstream.com"
# Webhook signature verification (src/app/api/webhooks/livekit/route.ts)
# uses LIVEKIT_API_KEY/LIVEKIT_API_SECRET above via WebhookReceiver — no
# separate webhook secret exists. An earlier version of this file listed
# one; removed as part of the Phase 5 security pass since it was unused
# and implied a secret that doesn't exist.

# --- Storage (Supabase Storage, via its S3-compatible API) ---
# Despite the AWS_*/S3_* names below, these point at Supabase Storage, not
# real AWS S3 — Supabase exposes an S3-compatible API that LiveKit's
# S3Upload egress output (src/lib/livekit.ts) and any other S3-SDK code
# can talk to directly, which is why the var names stayed generic. Get
# these from the Supabase dashboard: Project Settings → Storage → S3
# Connection.
AWS_REGION="us-east-1"                 # region shown in that S3 Connection panel
AWS_ACCESS_KEY_ID="xxx"                # "Access key ID" from S3 Connection
AWS_SECRET_ACCESS_KEY="xxx"            # "Secret access key" from S3 Connection
S3_ENDPOINT="https://<project-ref>.supabase.co/storage/v1/s3"
S3_BUCKET_CLIPS="fgc-stream-clips"     # bucket name as created in Storage — must match NEXT_PUBLIC_SUPABASE_BUCKET below

# Public playback URLs (src/lib/cdn.ts) — separate from the write-side
# credentials above. This is what actually builds the HLS/VOD URLs the
# viewer's browser fetches from, via Supabase's public object endpoint
# rather than a CloudFront distribution.
NEXT_PUBLIC_SUPABASE_STORAGE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_BUCKET="fgc-stream-clips"  # same bucket as S3_BUCKET_CLIPS

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SOCKET_SERVER_PORT="4000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
