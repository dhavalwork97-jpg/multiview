{
  "name": "fgc-stream",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "socket:dev": "tsx watch src/server/socket/index.ts",
    "clip-worker:dev": "tsx watch src/server/streaming/clip-worker.ts",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "setup": "bash scripts/setup.sh",
    "demo:pack": "tsx prisma/seed-demo-pack.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1121.0",
    "@clerk/nextjs": "6.9.0",
    "@livekit/protocol": "^1.29.3",
    "@prisma/client": "5.22.0",
    "@socket.io/redis-adapter": "8.3.0",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.3",
    "bullmq": "5.28.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "hls.js": "1.7.1",
    "ioredis": "5.4.1",
    "livekit-client": "2.22.1",
    "livekit-server-sdk": "2.18.0",
    "next": "15.1.11",
    "prisma": "5.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "stripe": "17.4.0",
    "svix": "^1.99.1",
    "tailwind-merge": "2.5.4",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.9.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "autoprefixer": "10.5.4",
    "eslint": "8.57.1",
    "eslint-config-next": "15.1.0",
    "postcss": "8.5.26",
    "tsx": "4.23.13",
    "vitest": "2.1.4"
  }
}
