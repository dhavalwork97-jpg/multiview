# Builds and runs ONLY the Socket.IO server (src/server/socket/index.ts).
# This is intentionally a separate image from the Next.js app: the two
# scale on different axes (stateless request/response vs. long-lived
# connections) and deploy to different platforms (Vercel vs. Fly.io here).
FROM node:20-slim AS base
WORKDIR /app

FROM base AS deps
COPY package.json package-lock.json* ./
RUN npm ci

FROM base AS runner
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY tsconfig.json ./
COPY src/server ./src/server
COPY src/lib ./src/lib

# tsx runs the TypeScript entrypoint directly — no separate build step
# needed for this small server, keeping the image simple.
EXPOSE 4000
CMD ["npx", "tsx", "src/server/socket/index.ts"]
