# Copy this to scripts/.setup.env and fill in what you have. Leave
# anything blank that you don't have yet -- setup.sh prints a manual-step
# instruction for each missing piece instead of failing silently.
#
# scripts/.setup.env is gitignored -- never commit real values.

GITHUB_REPO_NAME=fgc-stream

# Neon: dashboard.neon.tech -> API Keys (only needed if you have neonctl
# installed and want project creation automated too; otherwise just set
# DATABASE_URL directly after creating the project by hand)
NEON_API_KEY=
DATABASE_URL=

# Upstash: dashboard, top-right account icon -> API Keys
UPSTASH_EMAIL=
UPSTASH_API_KEY=
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AWS: needs an IAM identity with permission to create S3 buckets and IAM
# users -- usually your own admin credentials for this one-time setup, not
# the scoped media-server user this script goes on to create.
AWS_REGION=us-east-1
S3_BUCKET_VODS=fgc-stream-vods
S3_BUCKET_CLIPS=fgc-stream-clips
# populated automatically by section 4 -- copy from /tmp/fgc-stream-iam-key.json
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Clerk: dashboard.clerk.com -> your application -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe: dashboard.stripe.com -> Developers -> API keys, and the Price ID
# from the Product you create for Premium
STRIPE_SECRET_KEY=
STRIPE_PREMIUM_PRICE_ID=

# Filled in once the media server VM exists (section 8) -- re-run section 7
# after setting these
MEDIA_SERVER_HOST=
MEDIA_SERVER_SSH_USER=ubuntu
MEDIA_SERVER_SSH_KEY_FILE=
