generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MatchEvent {
  id               String         @id @default(cuid())
  matchId          String
  type             MatchEventType
  timestampSeconds Int
  confidence       Float
  metadata         Json?
  createdAt        DateTime       @default(now())
  match            Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@map("match_events")
}

model User {
  id                      String                   @id @default(cuid())
  clerkId                 String                   @unique
  email                   String                   @unique
  username                String                   @unique
  displayName             String?
  avatarUrl               String?
  role                    Role                     @default(VIEWER)
  stripeCustomerId        String?                  @unique
  stripeSubscriptionId    String?                  @unique
  subscriptionStatus      SubscriptionStatus       @default(NONE)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  trialStartedAt          DateTime?
  trialEndsAt             DateTime?
  clipsCreated            Clip[]
  favorites               Favorite[]
  sentInvitations         OrganizationInvitation[] @relation("InvitationInviter")
  organizationMemberships OrganizationMember[]
  ownedOrganizations      Organization[]           @relation("OrganizationOwner")
  playerProfile           Player?
  organizedTournaments    Tournament[]             @relation("TournamentOrganizer")
  watchHistory            WatchHistoryEntry[]

  @@index([role])
  @@map("users")
}

model Organization {
  id                String                   @id @default(cuid())
  name              String
  slug              String                   @unique
  ownerId           String
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  plan              PlanTier                 @default(FREE)
  brandLogoUrl      String?
  brandPrimaryColor String?
  brandAccentColor  String?
  customDomain      String?                  @unique
  tagline           String?
  dailyMetrics      EventDailyMetric[]
  notifications     Notification[]
  invitations       OrganizationInvitation[]
  members           OrganizationMember[]
  owner             User                     @relation("OrganizationOwner", fields: [ownerId], references: [id])
  sponsors          Sponsor[]
  incidents         TournamentIncident[]
  tournaments       Tournament[]

  @@index([ownerId])
  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(VIEWER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, role])
  @@map("organization_members")
}

model OrganizationInvitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           OrganizationRole @default(OPERATOR)
  tokenHash      String           @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  invitedById    String
  createdAt      DateTime         @default(now())
  invitedBy      User             @relation("InvitationInviter", fields: [invitedById], references: [id])
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@index([expiresAt])
  @@map("organization_invitations")
}

model TournamentIncident {
  id             String           @id @default(cuid())
  organizationId String
  tournamentId   String
  createdById    String?
  severity       IncidentSeverity @default(INFO)
  status         IncidentStatus   @default(OPEN)
  title          String
  details        String?
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tournament     Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId, status, createdAt])
  @@index([organizationId, createdAt])
  @@map("tournament_incidents")
}

model EventDailyMetric {
  id             String       @id @default(cuid())
  organizationId String
  tournamentId   String
  matchId        String?
  dayKey         String
  views          Int          @default(0)
  watchSeconds   Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, matchId, dayKey])
  @@index([organizationId, dayKey])
  @@index([tournamentId, dayKey])
  @@map("event_daily_metrics")
}

model Player {
  id                String              @id @default(cuid())
  gamertag          String              @unique
  realName          String?
  country           String?
  avatarUrl         String?
  userId            String?             @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  favoritedBy       Favorite[]
  matchParticipants MatchParticipant[]
  matchesAsP1       Match[]             @relation("MatchPlayerOne")
  matchesAsP2       Match[]             @relation("MatchPlayerTwo")
  user              User?               @relation(fields: [userId], references: [id])
  teamMemberships   TeamMember[]
  entrants          TournamentEntrant[]

  @@index([gamertag])
  @@map("players")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  playerId  String
  createdAt DateTime @default(now())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, playerId])
  @@map("favorites")
}

model Tournament {
  id                String               @id @default(cuid())
  name              String
  slug              String               @unique
  game              String
  status            TournamentStatus     @default(DRAFT)
  startDate         DateTime
  endDate           DateTime?
  venue             String?
  bracketSource     String?
  bracketExternalId String?
  organizerId       String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  organizationId    String
  format            TournamentFormat     @default(SINGLE_ELIMINATION)
  bestOf            Int                  @default(3)
  publicEnabled     Boolean              @default(true)
  publicTheme       Json?
  sport             String               @default("esports")
  competitionType   String               @default("tournament")
  participantMode   String               @default("individual")
  scoringMode       String               @default("points")
  competitionRules  Json?
  brackets          Bracket[]
  stages            CompetitionStage[]
  matches           Match[]
  notifications     Notification[]
  sponsors          Sponsor[]
  stations          Station[]
  entrants          TournamentEntrant[]
  incidents         TournamentIncident[]
  teams             TournamentTeam[]
  organization      Organization         @relation(fields: [organizationId], references: [id])
  organizer         User                 @relation("TournamentOrganizer", fields: [organizerId], references: [id])

  @@index([status])
  @@index([slug])
  @@index([organizationId, status])
  @@index([competitionType])
  @@index([sport])
  @@map("tournaments")
}

model Team {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  logoUrl           String?
  country           String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  matchParticipants MatchParticipant[]
  members           TeamMember[]
  tournaments       TournamentTeam[]

  @@index([name])
  @@map("teams")
}

model TeamMember {
  id       String  @id @default(cuid())
  teamId   String
  playerId String
  role     String?
  player   Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team     Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, playerId])
  @@map("team_members")
}

model TournamentTeam {
  id           String     @id @default(cuid())
  tournamentId String
  teamId       String
  seed         Int?
  eliminated   Boolean    @default(false)
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, teamId])
  @@map("tournament_teams")
}

model Sponsor {
  id             String       @id @default(cuid())
  organizationId String
  tournamentId   String
  name           String
  logoUrl        String?
  websiteUrl     String?
  bannerUrl      String?
  placement      String       @default("EVENT")
  weight         Int          @default(1)
  active         Boolean      @default(true)
  clicks         Int          @default(0)
  impressions    Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tournament     Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId, active])
  @@map("sponsors")
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  tournamentId   String?
  userId         String?
  type           NotificationType
  title          String
  message        String
  href           String?
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tournament     Tournament?      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model TournamentEntrant {
  id           String     @id @default(cuid())
  tournamentId String
  playerId     String
  seed         Int?
  eliminated   Boolean    @default(false)
  player       Player     @relation(fields: [playerId], references: [id])
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, playerId])
  @@map("tournament_entrants")
}

model CompetitionStage {
  id           String            @id @default(cuid())
  tournamentId String
  name         String
  kind         StageKind         @default(KNOCKOUT)
  orderIndex   Int
  status       String            @default("SCHEDULED")
  rules        Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  sourceSlots  AdvancementSlot[] @relation("AdvancementSourceStage")
  tournament   Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches      Match[]

  @@unique([tournamentId, orderIndex])
  @@index([tournamentId, kind])
  @@map("competition_stages")
}

model AdvancementSlot {
  id            String                @id @default(cuid())
  sourceType    AdvancementSourceType @default(MATCH_RESULT)
  outcome       AdvancementOutcome    @default(WINNER)
  sourceMatchId String?
  sourceStageId String?
  sourceRank    Int?
  targetMatchId String
  targetSideKey String
  sourceLabel   String?
  resolvedAt    DateTime?
  createdAt     DateTime              @default(now())
  sourceMatch   Match?                @relation("AdvancementSourceMatch", fields: [sourceMatchId], references: [id], onDelete: Cascade)
  sourceStage   CompetitionStage?     @relation("AdvancementSourceStage", fields: [sourceStageId], references: [id], onDelete: Cascade)
  targetMatch   Match                 @relation("AdvancementTargetMatch", fields: [targetMatchId], references: [id], onDelete: Cascade)

  @@unique([targetMatchId, targetSideKey])
  @@index([sourceMatchId, outcome])
  @@index([sourceStageId, sourceRank])
  @@map("advancement_slots")
}

model Bracket {
  id           String     @id @default(cuid())
  tournamentId String
  name         String
  format       String
  structure    Json
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches      Match[]

  @@map("brackets")
}

model Station {
  id                          String        @id @default(cuid())
  tournamentId                String
  label                       String
  status                      StationStatus @default(OFFLINE)
  streamKey                   String        @unique @default(cuid())
  ingressId                   String?
  ingestUrl                   String?
  playbackIdHls               String?
  playbackIdWebrtc            String?
  lastHeartbeatAt             DateTime?
  currentBitrateKbps          Int?
  droppedFrames               Int?          @default(0)
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt
  youtubeStreamId             String?
  youtubeBroadcastId          String?
  youtubeVideoId              String?
  youtubeIngestUrl            String?
  youtubeLiveStatus           String?
  youtubeLastStatusAt         DateTime?
  youtubeProvisioningAt       DateTime?
  youtubeStreamProvisioningAt DateTime?
  matches                     Match[]
  tournament                  Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, label])
  @@index([status])
  @@map("stations")
}

model Match {
  id                 String              @id @default(cuid())
  tournamentId       String
  bracketId          String?
  stationId          String?
  playerOneId        String?
  playerTwoId        String?
  playerOneScore     Int                 @default(0)
  playerTwoScore     Int                 @default(0)
  winnerId           String?
  round              String?
  status             MatchStatus         @default(QUEUED)
  startedAt          DateTime?
  endedAt            DateTime?
  hypeScore          Float?              @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  roundIndex         Int?
  matchIndex         Int?
  youtubeBroadcastId String?             @unique
  youtubeVideoId     String?
  engineVersion      String              @default("1")
  scoringAdapter     String              @default("points")
  rulesSnapshot      Json?
  winnerSideId       String?             @unique
  stageId            String?
  sourceAdvancements AdvancementSlot[]   @relation("AdvancementSourceMatch")
  targetAdvancements AdvancementSlot[]   @relation("AdvancementTargetMatch")
  clips              Clip[]
  events             MatchEvent[]
  scoreEvents        MatchScoreEvent[]
  sides              MatchSide[]         @relation("MatchSides")
  bracket            Bracket?            @relation(fields: [bracketId], references: [id])
  playerOne          Player?             @relation("MatchPlayerOne", fields: [playerOneId], references: [id], onDelete: Restrict)
  playerTwo          Player?             @relation("MatchPlayerTwo", fields: [playerTwoId], references: [id], onDelete: Restrict)
  stage              CompetitionStage?   @relation(fields: [stageId], references: [id])
  station            Station?            @relation(fields: [stationId], references: [id])
  tournament         Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  winnerSide         MatchSide?          @relation("MatchWinnerSide", fields: [winnerSideId], references: [id])
  recording          Recording?
  watchHistory       WatchHistoryEntry[]

  @@index([tournamentId, status])
  @@index([stationId])
  @@index([status, hypeScore])
  @@index([stageId])
  @@map("matches")
}

model MatchSide {
  id           String             @id @default(cuid())
  matchId      String
  sideKey      String
  label        String?
  score        Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  participants MatchParticipant[]
  scoreEvents  MatchScoreEvent[]
  match        Match              @relation("MatchSides", fields: [matchId], references: [id], onDelete: Cascade)
  winnerFor    Match?             @relation("MatchWinnerSide")

  @@unique([matchId, sideKey])
  @@index([matchId])
  @@map("match_sides")
}

model MatchParticipant {
  id          String    @id @default(cuid())
  sideId      String
  playerId    String?
  teamId      String?
  role        String?
  displayName String?
  createdAt   DateTime  @default(now())
  player      Player?   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  side        MatchSide @relation(fields: [sideId], references: [id], onDelete: Cascade)
  team        Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([sideId, playerId, teamId])
  @@index([playerId])
  @@index([teamId])
  @@map("match_participants")
}

model MatchScoreEvent {
  id        String    @id @default(cuid())
  matchId   String
  sideId    String
  sequence  Int
  metric    String
  value     Int       @default(0)
  period    String?
  metadata  Json?
  createdAt DateTime  @default(now())
  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  side      MatchSide @relation(fields: [sideId], references: [id], onDelete: Cascade)

  @@unique([matchId, sequence])
  @@index([matchId, sideId])
  @@map("match_score_events")
}

model ViewerSession {
  id           String   @id @default(cuid())
  sessionHash  String
  tournamentId String
  matchId      String
  dayKey       String
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @updatedAt

  @@unique([sessionHash, matchId, dayKey])
  @@index([tournamentId, dayKey])
  @@index([matchId, dayKey])
  @@map("viewer_sessions")
}

model AuditLog {
  id           String   @id @default(cuid())
  tournamentId String
  actorUserId  String?
  action       String
  entityType   String
  entityId     String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([tournamentId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model YouTubeQuotaLedger {
  dayKey       String    @id
  units        Int       @default(0)
  blockedUntil DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("youtube_quota_ledger")
}

model Recording {
  id              String          @id @default(cuid())
  matchId         String          @unique
  egressId        String?
  status          RecordingStatus @default(RECORDING)
  mp4S3Key        String?
  hlsPlaylistKey  String?
  durationSeconds Int?
  startedAt       DateTime        @default(now())
  endedAt         DateTime?
  match           Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("recordings")
}

model Clip {
  id           String     @id @default(cuid())
  matchId      String
  createdById  String?
  title        String?
  startSeconds Int
  endSeconds   Int
  status       ClipStatus @default(QUEUED)
  s3Key        String?
  thumbnailKey String?
  createdAt    DateTime   @default(now())
  createdBy    User?      @relation(fields: [createdById], references: [id])
  match        Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, status])
  @@map("clips")
}

model WebhookEvent {
  id         String   @id @default(cuid())
  source     String
  eventId    String
  receivedAt DateTime @default(now())

  @@unique([source, eventId])
  @@index([receivedAt])
  @@map("webhook_events")
}

model WatchHistoryEntry {
  id              String   @id @default(cuid())
  userId          String
  matchId         String
  watchedAt       DateTime @default(now())
  durationSeconds Int      @default(0)
  match           Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, watchedAt])
  @@map("watch_history_entries")
}

enum Role {
  VIEWER
  PLAYER
  ORGANIZER
  ADMIN
}

enum OrganizationRole {
  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

enum IncidentSeverity {
  INFO
  WARNING
  CRITICAL
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum TournamentStatus {
  DRAFT
  SCHEDULED
  LIVE
  COMPLETED
  ARCHIVED
}

enum StationStatus {
  OFFLINE
  IDLE
  LIVE
  ERROR
}

enum MatchStatus {
  QUEUED
  LIVE
  COMPLETED
  DISPUTED
}

enum StreamProtocol {
  WEBRTC
  HLS
}

enum MatchEventType {
  COMEBACK
  PERFECT_ROUND
  HYPE_SPIKE
}

enum PlanTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum StageKind {
  QUALIFIER
  GROUP
  SWISS
  LEAGUE
  KNOCKOUT
  CONSOLATION
  FINAL
  CUSTOM
}

enum AdvancementSourceType {
  MATCH_RESULT
  STAGE_RANK
  MANUAL
}

enum AdvancementOutcome {
  WINNER
  LOSER
  RANK
}

enum TournamentFormat {
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  ROUND_ROBIN
  SWISS
}

enum NotificationType {
  MATCH_STARTING
  MATCH_LIVE
  MATCH_COMPLETED
  BRACKET_ADVANCED
  STREAM_ALERT
  TOURNAMENT_UPDATE
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  PAST_DUE
  CANCELED
}

enum RecordingStatus {
  RECORDING
  PROCESSING
  READY
  FAILED
}

enum ClipStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}
