// ============================================================================
// FGC Stream — Phase 1 Schema
// Covers: auth/users, tournaments, players, stations, live matches
// Later phases will add: clips/VODs, AI highlight events, notifications,
// subscriptions/billing, watch history, favorites (stubbed here as models
// so Phase 1 API routes have something to point at, but not yet wired to UI).
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum Role {
  VIEWER
  PLAYER
  ORGANIZER
  ADMIN
}

enum OrganizationRole {
  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

enum IncidentSeverity {
  INFO
  WARNING
  CRITICAL
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum TournamentStatus {
  DRAFT
  SCHEDULED
  LIVE
  COMPLETED
  ARCHIVED
}

enum StationStatus {
  OFFLINE       // no encoder connected
  IDLE          // encoder connected, no active match
  LIVE          // actively streaming a match
  ERROR         // encoder connected but unhealthy (dropped frames, etc.)
}

enum MatchStatus {
  QUEUED        // assigned to a station, not started
  LIVE
  COMPLETED
  DISPUTED
}

enum StreamProtocol {
  WEBRTC
  HLS
}

enum MatchEventType {
  COMEBACK
  PERFECT_ROUND
  HYPE_SPIKE
}

// AI-detected (or, later, scorekeeper-flagged) notable moments. Each one
// is both a UI marker on the watch page/bracket AND — for COMEBACK and
// PERFECT_ROUND — the trigger for an auto-generated Clip (see
// src/server/ai/hype-worker.ts). timestampSeconds is relative to the
// match's Recording, same coordinate space Clip.startSeconds/endSeconds
// already use, so no separate mapping is needed between the two.
model MatchEvent {
  id               String         @id @default(cuid())
  matchId          String
  type             MatchEventType
  timestampSeconds Int
  confidence       Float          // 0–1, heuristic-derived — see hype-worker.ts caveats
  metadata         Json?          // e.g. { playerLowHpFraction: 0.08, side: "playerOne" }
  createdAt        DateTime       @default(now())

  match            Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@map("match_events")
}

enum PlanTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum TournamentFormat {
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  ROUND_ROBIN
  SWISS
}

enum NotificationType {
  MATCH_STARTING
  MATCH_LIVE
  MATCH_COMPLETED
  BRACKET_ADVANCED
  STREAM_ALERT
  TOURNAMENT_UPDATE
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  PAST_DUE
  CANCELED
}

// Clerk is the identity provider — this table mirrors Clerk users by
// clerkId so we can attach app-specific data (role, favorites, etc).
// Synced via the /api/webhooks/clerk route (user.created/updated/deleted).
// ----------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  clerkId       String   @unique
  email         String   @unique
  username      String   @unique
  displayName   String?
  avatarUrl     String?
  role          Role     @default(VIEWER)

  stripeCustomerId     String?             @unique
  stripeSubscriptionId String?             @unique
  subscriptionStatus   SubscriptionStatus  @default(NONE)
  trialStartedAt        DateTime?
  trialEndsAt           DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organizedTournaments Tournament[]      @relation("TournamentOrganizer")
  ownedOrganizations Organization[]       @relation("OrganizationOwner")
  organizationMemberships OrganizationMember[]
  sentInvitations OrganizationInvitation[] @relation("InvitationInviter")
  playerProfile        Player?
  favorites            Favorite[]
  watchHistory         WatchHistoryEntry[]
  clipsCreated         Clip[]

  @@index([role])
  @@map("users")
}


model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String
  owner     User     @relation("OrganizationOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  plan          PlanTier @default(FREE)
  brandLogoUrl  String?
  brandPrimaryColor String?
  brandAccentColor String?
  customDomain  String? @unique
  tagline       String?

  members       OrganizationMember[]
  invitations   OrganizationInvitation[]
  tournaments   Tournament[]
  incidents     TournamentIncident[]
  dailyMetrics  EventDailyMetric[]
  sponsors      Sponsor[]
  notifications Notification[]

  @@index([ownerId])
  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(VIEWER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, role])
  @@map("organization_members")
}

model OrganizationInvitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           OrganizationRole @default(OPERATOR)
  tokenHash      String           @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  invitedById    String
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationInviter", fields: [invitedById], references: [id])

  @@index([organizationId, email])
  @@index([expiresAt])
  @@map("organization_invitations")
}

model TournamentIncident {
  id             String           @id @default(cuid())
  organizationId String
  tournamentId   String
  createdById    String?
  severity       IncidentSeverity @default(INFO)
  status         IncidentStatus   @default(OPEN)
  title          String
  details        String?
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tournament   Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId, status, createdAt])
  @@index([organizationId, createdAt])
  @@map("tournament_incidents")
}

model EventDailyMetric {
  id             String   @id @default(cuid())
  organizationId String
  tournamentId   String
  matchId        String?
  dayKey         String
  views          Int      @default(0)
  watchSeconds   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, matchId, dayKey])
  @@index([organizationId, dayKey])
  @@index([tournamentId, dayKey])
  @@map("event_daily_metrics")
}

// A Player is the competitive identity (gamertag) shown on brackets,
// separate from User so organizers can register players who don't yet
// have — or never make — a platform account.
model Player {
  id           String   @id @default(cuid())
  gamertag     String   @unique
  realName     String?
  country      String?
  avatarUrl    String?

  userId       String?  @unique
  user         User?    @relation(fields: [userId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entrants     TournamentEntrant[]
  matchesAsP1  Match[]  @relation("MatchPlayerOne")
  matchesAsP2  Match[]  @relation("MatchPlayerTwo")
  matchParticipants MatchParticipant[]
  favoritedBy  Favorite[]
  teamMemberships TeamMember[]

  @@index([gamertag])
  @@map("players")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  playerId  String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([userId, playerId])
  @@map("favorites")
}

// ----------------------------------------------------------------------------
// Tournaments
// ----------------------------------------------------------------------------

model Tournament {
  id            String            @id @default(cuid())
  name          String
  slug          String            @unique
  game          String            // Legacy display/game title; retained for compatibility.
  sport         String            @default("esports")
  competitionType String          @default("tournament")
  participantMode String          @default("individual")
  scoringMode   String            @default("points")
  competitionRules Json?
  status        TournamentStatus  @default(DRAFT)
  startDate     DateTime
  endDate       DateTime?
  venue         String?
  bracketSource String?           // e.g. "start.gg" — provenance of imported bracket
  format        TournamentFormat  @default(SINGLE_ELIMINATION)
  bestOf        Int               @default(3)
  publicEnabled Boolean            @default(true)
  publicTheme   Json?
  bracketExternalId String?       // id in the source system, for re-sync

  organizerId   String
  organizer     User              @relation("TournamentOrganizer", fields: [organizerId], references: [id])
  organizationId String
  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  entrants      TournamentEntrant[]
  teams         TournamentTeam[]
  stations      Station[]
  matches       Match[]
  brackets      Bracket[]
  incidents     TournamentIncident[]
  notifications Notification[]
  sponsors      Sponsor[]

  @@index([status])
  @@index([slug])
  @@index([organizationId, status])
  @@map("tournaments")
}

model Team {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  country     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     TeamMember[]
  tournaments TournamentTeam[]
  matchParticipants MatchParticipant[]

  @@index([name])
  @@map("teams")
}

model TeamMember {
  id        String @id @default(cuid())
  teamId    String
  playerId  String
  role      String?
  team      Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player    Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  @@unique([teamId, playerId])
  @@map("team_members")
}

model TournamentTeam {
  id           String @id @default(cuid())
  tournamentId String
  teamId       String
  seed         Int?
  eliminated   Boolean @default(false)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team         Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  @@unique([tournamentId, teamId])
  @@map("tournament_teams")
}

model Sponsor {
  id             String @id @default(cuid())
  organizationId String
  tournamentId   String
  name           String
  logoUrl        String?
  websiteUrl     String?
  bannerUrl      String?
  placement      String @default("EVENT")
  weight         Int @default(1)
  active         Boolean @default(true)
  clicks         Int @default(0)
  impressions    Int @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tournament     Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  @@index([tournamentId, active])
  @@map("sponsors")
}

model Notification {
  id             String @id @default(cuid())
  organizationId String
  tournamentId   String?
  userId         String?
  type           NotificationType
  title          String
  message        String
  href           String?
  readAt         DateTime?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tournament     Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  @@index([organizationId, createdAt])
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model TournamentEntrant {
  id            String     @id @default(cuid())
  tournamentId  String
  playerId      String
  seed          Int?
  eliminated    Boolean    @default(false)

  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player        Player     @relation(fields: [playerId], references: [id])

  @@unique([tournamentId, playerId])
  @@map("tournament_entrants")
}

// A Bracket is deliberately a thin wrapper: full bracket topology (pools,
// double-elim trees, seeding lines) is stored as JSON imported from the
// source (e.g. start.gg's GraphQL bracket export), and re-derived on sync
// rather than modeled relationally. Match rows are still first-class/relational
// because streaming, station-assignment, and live score updates all key off Match.
model Bracket {
  id            String     @id @default(cuid())
  tournamentId  String
  name          String     // "Winners Bracket", "Losers Bracket", "Pools A"
  format        String     // "double_elimination" | "single_elimination" | "round_robin" | "swiss"
  structure     Json       // raw imported bracket tree/positions

  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches       Match[]

  @@map("brackets")
}

// ----------------------------------------------------------------------------
// Stations & Streaming
// A Station = one physical PS5 + capture/encoder rig at the venue.
// Its live status is driven by the RTMP/WHIP ingest heartbeat, not just DB
// state — see src/server/streaming for the reconciliation loop.
// ----------------------------------------------------------------------------

model Station {
  id              String         @id @default(cuid())
  tournamentId    String
  label           String         // "Station 12", "Pool A - Setup 3"
  status          StationStatus  @default(OFFLINE)

  streamKey       String         @unique @default(cuid()) // LiveKit-issued RTMP stream key once an ingress is created
  ingressId       String?        // LiveKit Ingress resource id
  ingestUrl       String?        // RTMP/WHIP ingest endpoint assigned to this station
  playbackIdHls   String?        // CloudFront path prefix for this station's live HLS output
  playbackIdWebrtc String?       // Legacy LiveKit room name; retained during migration
  youtubeStreamId String?       // Persistent YouTube Live Stream resource for this station
  youtubeBroadcastId String?    // Current YouTube Live Broadcast resource for this station session
  youtubeVideoId String?        // Current YouTube video/live playback id
  youtubeIngestUrl String?      // YouTube RTMP ingest URL
  youtubeLiveStatus String?     // created|ready|liveStarting|live|complete|...
  youtubeLastStatusAt DateTime?
  // Prevent concurrent Start requests from creating duplicate YouTube broadcasts.
  youtubeProvisioningAt DateTime?
  youtubeStreamProvisioningAt DateTime?

  lastHeartbeatAt DateTime?
  currentBitrateKbps Int?
  droppedFrames   Int?           @default(0)

  tournament      Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches         Match[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([tournamentId, label])
  @@index([status])
  @@map("stations")
}

model Match {
  id            String       @id @default(cuid())
  tournamentId  String
  bracketId     String?
  stationId     String?

  // Legacy player columns are nullable compatibility fields. New matches should
  // use sides/participants below. Existing FGC matches continue to work.
  playerOneId   String?
  playerTwoId   String?
  playerOneScore Int        @default(0)
  playerTwoScore Int        @default(0)
  winnerId      String?

  // Generic Match Engine state.
  engineVersion String       @default("1")
  scoringAdapter String      @default("points")
  rulesSnapshot Json?
  winnerSideId  String?      @unique

  round         String?      // "Winners Semis", "Pool A Round 2", etc.
  status        MatchStatus  @default(QUEUED)

  startedAt     DateTime?
  endedAt       DateTime?

  // Denormalized "hype" score, updated by the AI highlight pipeline (Phase 4+).
  hypeScore     Float?       @default(0)

  // Match-scoped reference to the station's current YouTube broadcast.
  youtubeBroadcastId String?
  youtubeVideoId     String?

  roundIndex    Int?
  matchIndex    Int?

  tournament    Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  bracket       Bracket?     @relation(fields: [bracketId], references: [id])
  station       Station?     @relation(fields: [stationId], references: [id])
  playerOne     Player?      @relation("MatchPlayerOne", fields: [playerOneId], references: [id])
  playerTwo     Player?      @relation("MatchPlayerTwo", fields: [playerTwoId], references: [id])
  winnerSide    MatchSide?   @relation("MatchWinnerSide", fields: [winnerSideId], references: [id])

  sides         MatchSide[]       @relation("MatchSides")
  scoreEvents   MatchScoreEvent[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  watchHistory  WatchHistoryEntry[]
  recording     Recording?
  clips         Clip[]
  events        MatchEvent[]

  @@index([tournamentId, status])
  @@index([stationId])
  @@index([status, hypeScore])
  @@map("matches")
}

// A match always has two sides, but a side can contain one participant
// (Street Fighter, tennis singles) or many participants (football, cricket,
// Valorant, doubles tennis, BGMI squads). This is the generic boundary between
// match mechanics and the domain entities competing in the match.
model MatchSide {
  id          String   @id @default(cuid())
  matchId     String
  sideKey     String   // "A" | "B" — stable machine key, not a player/team name
  label       String?
  score       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  match       Match   @relation("MatchSides", fields: [matchId], references: [id], onDelete: Cascade)
  winnerFor   Match?  @relation("MatchWinnerSide")
  participants MatchParticipant[]
  scoreEvents MatchScoreEvent[]

  @@unique([matchId, sideKey])
  @@index([matchId])
  @@map("match_sides")
}

// A participant is deliberately polymorphic at the application boundary: a
// row can point to a Player or a Team. A Side is what permits pairs/squads to
// be represented without changing Match itself. Validation lives in the
// engine so the database can remain compatible with future participant types.
model MatchParticipant {
  id          String   @id @default(cuid())
  sideId      String
  playerId    String?
  teamId      String?
  role        String?
  displayName String?
  createdAt   DateTime @default(now())

  side        MatchSide @relation(fields: [sideId], references: [id], onDelete: Cascade)
  player      Player?   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team        Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([sideId, playerId, teamId])
  @@index([playerId])
  @@index([teamId])
  @@map("match_participants")
}

// Immutable scoring ledger. The current side score is a projection; these
// events are the audit trail that lets sport-specific adapters reason about
// periods, wickets, kills, sets, rounds, points, etc. without hard-coding them
// into Match.
model MatchScoreEvent {
  id          String   @id @default(cuid())
  matchId     String
  sideId      String
  sequence    Int
  metric      String   // "points", "goals", "runs", "rounds", "sets", "kills", ...
  value       Int      @default(0)
  period      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  match       Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  side        MatchSide @relation(fields: [sideId], references: [id], onDelete: Cascade)

  @@unique([matchId, sequence])
  @@index([matchId, sideId])
  @@map("match_score_events")
}


model ViewerSession {
  id            String   @id @default(cuid())
  sessionHash   String
  tournamentId  String
  matchId       String
  dayKey        String
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @updatedAt

  @@unique([sessionHash, matchId, dayKey])
  @@index([tournamentId, dayKey])
  @@index([matchId, dayKey])
  @@map("viewer_sessions")
}

model AuditLog {
  id           String   @id @default(cuid())
  tournamentId String
  actorUserId  String?
  action       String
  entityType   String
  entityId     String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([tournamentId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model YouTubeQuotaLedger {
  // UTC calendar day. One row per day lets us enforce an application-side
  // safety budget before spending YouTube write quota.
  dayKey      String   @id
  units       Int      @default(0)
  blockedUntil DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("youtube_quota_ledger")
}

enum RecordingStatus {
  RECORDING
  PROCESSING
  READY
  FAILED
}

enum ClipStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

// One per Match. Egress writes continuously to S3 while status=RECORDING
// (both an MP4 and a live-growing HLS playlist, from the same egress job —
// see STREAMING_ARCHITECTURE.md); READY once the LiveKit `egress_ended`
// webhook fires and the MP4 is finalized. hlsPlaylistKey stays populated
// even mid-match so the DVR-style "watch from a bit ago" scrubbing works
// on a live match, not just after it ends.
model Recording {
  id              String          @id @default(cuid())
  matchId         String          @unique
  egressId        String?         // LiveKit egress job id, for status polling/cancellation
  status          RecordingStatus @default(RECORDING)
  mp4S3Key        String?
  hlsPlaylistKey  String?
  durationSeconds Int?
  startedAt       DateTime        @default(now())
  endedAt         DateTime?

  match           Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("recordings")
}

// A user-triggered (or AI-triggered, Phase 4) cut of a match's recording.
// Cutting happens against the *live* HLS segments already in S3 while a
// match is in progress — that's what makes "instant replay" instant
// instead of waiting for the full match recording to finalize.
model Clip {
  id           String     @id @default(cuid())
  matchId      String
  createdById  String?    // null = system-generated (Phase 4 AI highlights)
  title        String?
  startSeconds Int
  endSeconds   Int
  status       ClipStatus @default(QUEUED)
  s3Key        String?
  thumbnailKey String?
  createdAt    DateTime   @default(now())

  match        Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdBy    User?      @relation(fields: [createdById], references: [id])

  @@index([matchId, status])
  @@map("clips")
}

// Dedupe table for POST /api/webhooks/livekit. LiveKit (like most webhook
// senders) retries on anything but a fast 2xx, and a flappy connection or a
// slow response can easily cause the same event to be delivered twice.
// Previously the only guard was re-checking LiveKit's *current* egress
// state, which prevents a duplicate egress start but doesn't stop a
// duplicate from re-running everything else in the handler (Match/Recording
// writes, publishEvent). Every LiveKit webhook payload carries a stable
// `id` — recording it here and checking it first makes the whole handler
// idempotent per event, not just the egress-start branch.
model WebhookEvent {
  id          String   @id @default(cuid())
  source      String   // "livekit" | "clerk" | "stripe" — scoped per-source in case IDs collide across providers
  eventId     String   // the sender's own event id (LiveKit WebhookEvent.id, svix-id, Stripe event.id)
  receivedAt  DateTime @default(now())

  @@unique([source, eventId])
  @@index([receivedAt])
  @@map("webhook_events")
}

model WatchHistoryEntry {
  id              String   @id @default(cuid())
  userId          String
  matchId         String
  watchedAt       DateTime @default(now())
  durationSeconds Int      @default(0)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([userId, watchedAt])
  @@map("watch_history_entries")
}